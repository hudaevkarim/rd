# Переменные окружения signaling-сервера.
# Скопируйте в .env или задайте в окружении. Все значения необязательны —
# сервер стартует с разумными умолчаниями и проверяет их при чтении.

# ─── Сеть ─────────────────────────────────────��─────────────────────────────────
HOST=0.0.0.0
PORT=8787
# Публичный адрес: только для логов и подсказок в /config.
PUBLIC_URL=http://localhost:8787

# ─── Ограничения ───────────────────────────────────────────────────────────────
# Максимум участников в комнате. Полная mesh-топология даёт n*(n-1)/2 соединений,
# поэтому 8 — это 28 соединений и 56 DataChannel на комнату.
MAX_ROOM_PEERS=8
# Токенов в секунду на одно WebSocket-соединение (управляющие сообщения).
RATE_PER_SEC=20
# Ёмкость пачки токенов: позволяет короткий всплеск SDP при установке.
RATE_BURST=60
# Сколько WebSocket-соединений один IP может открыть в минуту.
CONNECT_PER_MIN=30
CONNECT_BURST=30
# После N нарушений лимита соединение закрывается.
MAX_BUFFERED_BYTES=524288
# Пустая комната удаляется через столько миллисекунд. Задержка нужна, чтобы
# участник, кратковременно потерявший сеть, вернулся в ту же комнату.
ROOM_IDLE_EVICT_MS=60000

# ─── Клиент ────────────────────────────────────────────────────────────────────
# Разрешённые источники для CORS через запятую. Пусто — CORS выключен.
# WebSocket-подключения CORS не касаются: для них важны только wss:// и CSP.
CORS_ORIGIN=
LOG_LEVEL=info

# ─── ICE ───────────────────────────────────────────────────────────────────────
# Список STUN/TURN через запятую либо JSON-массив с учётными данными:
#   ICE_SERVERS=stun:stun.cloudflare.com:3478
#   ICE_SERVERS=[{"urls":"turn:turn.example.com","username":"u","credential":"p"}]
#
# TURN по умолчанию НЕ задан намеренно: TURN видит ваш шифротекст и метаданные
# (адреса, тайминги, объём). Для приватного приложения выбор TURN-провайдера
# должен быть явным решением оператора, а не значением по умолчанию.
# Без TURN соединение не установится между двумя симметричными NAT.
ICE_SERVERS=stun:stun.cloudflare.com:3478

# ─── Клиент (Vite, только для сборки фронтенда) ────────────────────────────────
# Адрес signaling-сервера, зашивается в клиент на этапе сборки.
VITE_SIGNALING_URL=ws://localhost:8787/ws
