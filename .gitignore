packages/e2e/playwright-report/
packages/e2e/blob-report/
packages/e2e/.cache/

# Артефакты нагрузочного теста: отчёты и сырые выгрузки k6. Последние весят
# сотни мегабайт, и в репозитории им не место — воспроизводятся прогоном.
reports/

